# ── Environment ───────────────────────────────────────────────────────────────
.env
# Every copy of it too: a backup like `.env.before-x` holds the same secrets.
.env.*
!.env.example

# ── AI / tooling state ────────────────────────────────────────────────────────
# A person's own settings; `.claude-plugin/` and `.cursor-plugin/` are the
# published manifests.
.claude/
.agents/
.gemini/
.aider*
.cursor/

# ── Evals ─────────────────────────────────────────────────────────────────────
# `claude plugin eval` writes each run's results and report here.
evals/results/

# ── Local ─────────────────────────────────────────────────────────────────────
# The maintainer's own notes, never repo docs.
scratch/
*.log

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.zed/
.fleet/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.orig
*.rej
*.bak
.DS_Store
._*
Thumbs.db
Desktop.ini
